APP_NAME=qrq
ENVIRONMENT=production
FRONTEND_URL=https://amoeba.q4queue.com

# ── Security ──────────────────────────────────────────────────
# Change this to a secure random string!
SECRET_KEY=generate_a_long_random_secure_key_here

# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://appuser:apppassword@postgres:5432/queuedb

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Server ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# -- email credential ------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="Q4Queue Notifications"

# ── Meta WhatsApp Cloud API ───────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_WABA_ID=your_waba_id_here
WHATSAPP_VERIFY_TOKEN=qrq-whatsapp-webhook-secret
WHATSAPP_API_VERSION=v25.0
