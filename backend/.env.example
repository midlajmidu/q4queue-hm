# ── Application ───────────────────────────────────────────────
APP_NAME=Q4Queue
ENVIRONMENT=development
FRONTEND_URL=https://your-production-domain.com

# ── Security ──────────────────────────────────────────────────
SECRET_KEY=your_secret_key_here

# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://dbuser:dbpassword@postgres:5432/dbname

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis-url

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=https://your-production-domain.com,http://localhost:3000

# ── Server ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# -- email credential ------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM_EMAIL="your_email@gmail.com"
SMTP_FROM_NAME="Q4Queue Notifications"

# ── Meta WhatsApp Cloud API ───────────────────────────────────
WHATSAPP_ACCESS_TOKEN="your_meta_access_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id_here"
WHATSAPP_WABA_ID="your_whatsapp_business_account_id_here"
WHATSAPP_VERIFY_TOKEN="qrq-whatsapp-webhook-secret"
WHATSAPP_API_VERSION="v25.0"

# ── Plivo WebRTC Configuration ────────────────────────────────
PLIVO_AUTH_ID="your_plivo_auth_id_here"
PLIVO_AUTH_TOKEN="your_plivo_auth_token_here"
PLIVO_WEBRTC_USERNAME="your_plivo_webrtc_username_here"
PLIVO_WEBRTC_PASSWORD="your_plivo_webrtc_password_here"
PLIVO_SOURCE_PHONE="your_plivo_source_phone_number_here"
