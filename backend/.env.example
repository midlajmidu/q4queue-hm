# ── Application Configuration ─────────────────────────────────────
APP_NAME=Q4Queue
ENVIRONMENT=production

# Public application base URL (e.g., https://app.q4queue.com)
APP_URL=https://app.q4queue.com
FRONTEND_URL=https://app.q4queue.com

# Marketing landing page URL (e.g., https://q4queue.com)
LANDING_URL=https://q4queue.com

# Public API URL for external webhooks (WhatsApp, Plivo callbacks)
PUBLIC_API_URL=https://app.q4queue.com

# Internal service URLs (Docker network)
BACKEND_INTERNAL_URL=http://backend:8000
FRONTEND_INTERNAL_URL=http://frontend:3000

# ── Security & Authentication ─────────────────────────────────────
# Generate a secure 64-character random string: `openssl rand -hex 32`
SECRET_KEY=replace-with-a-very-long-random-secret-key-at-least-32-chars
SUPER_ADMIN_EMAIL=admin@q4queue.com
SUPER_ADMIN_PASSWORD=replace-with-a-secure-password-min-14-chars

# ── PostgreSQL Database ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://appuser:replace_with_db_password@postgres:5432/queuedb

# ── Redis Cache & Distributed Locks ──────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS Origins ──────────────────────────────────────────────────
# Comma-separated list of allowed origins (in production: app.q4queue.com and optionally q4queue.com)
CORS_ORIGINS=https://app.q4queue.com,https://q4queue.com

# ── Server Binding ────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Storage & Backups ─────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
BACKUP_DIR=/app/backups

# ── Email / SMTP (Google Workspace / Amazon SES / SendGrid) ───────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@q4queue.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=notifications@q4queue.com
SMTP_FROM_NAME="Q4Queue Notifications"
SMTP_TLS=true
SMTP_SSL=false

# ── Meta WhatsApp Cloud API ───────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_WABA_ID=your_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=replace_with_a_secure_webhook_verify_token
WHATSAPP_API_VERSION=v25.0

# ── Plivo WebRTC & Voice Calling ──────────────────────────────────
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_WEBRTC_USERNAME=counteragent_username
PLIVO_WEBRTC_PASSWORD=counteragent_password
PLIVO_SOURCE_PHONE=+1234567890
