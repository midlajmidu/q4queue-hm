version: "3.9"

# ═══════════════════════════════════════════════════════════════════════════════
# DEVELOPMENT docker-compose
# ═══════════════════════════════════════════════════════════════════════════════

services:
  frontend:
    build:
      context: ./frontend
      target: builder
    command: npm run dev
    environment:
      - NODE_ENV=development
    volumes:
      - ./frontend:/app
      - /app/node_modules
      - /app/.next
