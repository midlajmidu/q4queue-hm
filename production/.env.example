# ═══════════════════════════════════════════════════════════════════════════════
# Q4QUEUE PRODUCTION ENVIRONMENT CONFIGURATION (AWS EC2 / DOCKER COMPOSE)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Release & Image Versioning ───────────────────────────────────────────────
Q4QUEUE_VERSION=v1.0.0
DOCKER_IMAGE_BACKEND=q4queue/app:backend-v1.0.0
DOCKER_IMAGE_FRONTEND=q4queue/app:frontend-v1.0.0
DOCKER_IMAGE_LANDING=q4queue/app:landing-v1.0.0

# ── Application Environment & Domains ────────────────────────────────────────
ENVIRONMENT=production
TZ=Asia/Kolkata
APP_NAME=Q4Queue

# The primary SaaS application domain running on AWS EC2 behind NGINX
APP_URL=https://app.q4queue.com
FRONTEND_URL=https://app.q4queue.com

# Marketing / Landing website domain deployed separately to Vercel
LANDING_URL=https://q4queue.com

# Public API URL used for generating external callbacks (Meta WhatsApp & Plivo)
PUBLIC_API_URL=https://app.q4queue.com

# Internal Docker network addresses
BACKEND_INTERNAL_URL=http://backend:8000
FRONTEND_INTERNAL_URL=http://frontend:3000
BACKEND_URL=http://backend:8000

# Next.js browser client environment
NEXT_PUBLIC_APP_URL=https://app.q4queue.com
NEXT_PUBLIC_LANDING_URL=https://q4queue.com
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_BASE_URL=wss://app.q4queue.com

# ── Security & Authentication ────────────────────────────────────────────────
# Generate a cryptographically secure 64-character hex key: `openssl rand -hex 32`
SECRET_KEY=replace_with_a_generated_64_character_hex_secret_key

# Initial super admin bootstrap credentials (only applied on first database boot)
SUPER_ADMIN_EMAIL=admin@q4queue.com
SUPER_ADMIN_PASSWORD=replace_with_a_strong_password_minimum_14_characters

# Strict production CORS origins (no localhost or wildcards)
CORS_ORIGINS=https://app.q4queue.com,https://q4queue.com

# ── PostgreSQL Database ──────────────────────────────────────────────────────
# Internal only: NOT exposed to host in production
POSTGRES_DB=queuedb
POSTGRES_USER=q4queue_user
POSTGRES_PASSWORD=replace_with_a_secure_database_password
DATABASE_URL=postgresql+asyncpg://q4queue_user:replace_with_a_secure_database_password@postgres:5432/queuedb

# ── Redis Cache & Distributed Locking ────────────────────────────────────────
# Internal only: NOT exposed to host in production
REDIS_URL=redis://redis:6379/0

# ── Storage Directories (Persistent EBS Docker Volumes) ──────────────────────
UPLOAD_DIR=/app/uploads
BACKUP_DIR=/app/backups

# ── Email / SMTP Notifications ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@q4queue.com
SMTP_PASSWORD=your_app_specific_smtp_password
SMTP_FROM_EMAIL=notifications@q4queue.com
SMTP_FROM_NAME="Q4Queue Notifications"
SMTP_TLS=true
SMTP_SSL=false

# ── Meta WhatsApp Cloud API (Webhook: https://app.q4queue.com/api/v1/webhooks/whatsapp)
WHATSAPP_ACCESS_TOKEN=your_permanent_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_WABA_ID=your_whatsapp_business_account_id
WHATSAPP_VERIFY_TOKEN=replace_with_a_secure_random_verification_string
WHATSAPP_API_VERSION=v25.0

# ── Plivo WebRTC & Voice (Answer: https://app.q4queue.com/api/v1/plivo/answer)
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_WEBRTC_USERNAME=counteragent_default
PLIVO_WEBRTC_PASSWORD=counteragent_password
PLIVO_SOURCE_PHONE=+1234567890
